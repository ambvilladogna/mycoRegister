{
    "name": "mycoRegister",
    "version": "0.0.2",
    "description": "Progressive Web Application with authentication",
    "main": "server.js",
    "scripts": {
        "setup": "npm install",
        "build": "node scripts/build.js",
        "start": "npm run build && node --enable-source-maps dist/server/server.js",
        "dev": "nodemon --watch server --watch public --ext js,json,html,css --exec \"node scripts/build.js && node --enable-source-maps dist/server/server.js\""
    },
    "dependencies": {
        "bcryptjs": "^3.0.2",
        "compression": "^1.8.0",
        "cookie-parser": "^1.4.7",
        "dompurify": "3.2.6",
        "dotenv": "^16.5.0",
        "esbuild": "^0.28.2",
        "events": "3.3.0",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "jsdom": "^26.1.0",
        "jsonwebtoken": "^9.0.2",
        "leaflet": "1.9.4",
        "morgan": "^1.10.0",
        "nano": "^10.1.4",
        "nodemailer": "^10.0.12",
        "open": "^10.1.2",
        "pouchdb-browser": "8.0.1",
        "pouchdb-find": "8.0.1",
        "readline": "^1.3.0"
    },
    "devDependencies": {
        "axios": "^1.9.0",
        "nodemon": "^3.1.10",
        "xlsx": "^0.18.5"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "author": "quackmore",
    "license": "BEER_WARE",
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
